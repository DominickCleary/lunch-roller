{
  "name": "lunch-roller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @lunch/web dev",
    "dev:worker": "pnpm --filter @lunch/worker dev",
    "build": "pnpm --filter @lunch/web build && pnpm --filter @lunch/worker build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @lunch/db generate",
    "db:migrate": "pnpm --filter @lunch/db migrate",
    "db:seed": "pnpm --filter @lunch/db seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
